# Copier ce fichier en .env.local (développement) ou fournir ces variables
# au conteneur Docker (--env-file). Ne JAMAIS versionner les vraies valeurs.

# Identifiant de l'administrateur (par défaut : admin)
ADMIN_USERNAME=admin
# Mot de passe administrateur : 10 caractères minimum
ADMIN_PASSWORD=change-moi-avec-un-vrai-mot-de-passe
# Clé de signature des sessions : 32 caractères minimum, aléatoire
# (générer avec : openssl rand -base64 48)
SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-48-caracteres
# Emplacement de la base SQLite (par défaut : ./data/ivoiremarket.db)
# DATABASE_PATH=./data/ivoiremarket.db
# Mettre true uniquement si le site est servi en HTTPS
# COOKIE_SECURE=false
